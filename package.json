{
  "name": "kamilla-akhmedova-website",
  "version": "1.0.0",
  "private": true,
  "description": "Kamilla Akhmedova advocacy and support website",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/build.cjs",
    "check": "node scripts/check.cjs && node --check src/scripts/navigation.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "verify": "npm run format:check && npm run lint && npm run build && npm run check"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "browser-sync": "3.0.4",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
